{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "Commerce": {
    "Environment": "Staging",
    "Cache": {
      "Enabled": true,
      "Provider": "Redis"
    },
    "Deployment": {
      "ApplyMigrationsOnStartup": true,
      "WaitForDatabaseSeconds": 90,
      "DatabaseRetryDelaySeconds": 3
    },
    "DisasterRecovery": {
      "EnableScheduledBackups": true
    }
  }
}
