# Copy to `.env` in this directory. Never commit `.env` or production secrets.
#
# Development defaults only — change all passwords before staging/production.

# SQL Server (required)
MSSQL_SA_PASSWORD=ChangeMe_DevOnly_123!

# Public URL exposed to operators during dev (direct port 8080)
COMMERCE_BASE_URL=http://localhost:8080

# Optional automated bootstrap (scripts/deploy/test-clean-install.*)
COMMERCE_ADMIN_EMAIL=admin@example.com
COMMERCE_ADMIN_USERNAME=admin
COMMERCE_ADMIN_PASSWORD=ChangeMe_Admin_123!
COMMERCE_STORE_NAME=Default Store
COMMERCE_STORE_HOST=localhost

# Staging / production (used with compose overlays)
COMMERCE_DOMAIN=commerce.example.com
CADDY_EMAIL=ops@example.com

# TLS (production overlay — mount real certs, never commit private keys)
# TLS_CERT_FILE=./secrets/tls/fullchain.pem
# TLS_KEY_FILE=./secrets/tls/privkey.pem
