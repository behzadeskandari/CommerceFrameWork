{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.EntityFrameworkCore": "Information",
            "Microsoft.AspNetCore.Hosting": "Debug"
        }
    },
    "AllowedHosts": "*",
    "Commerce": {
        "ApplicationName": "Commerce",
        "Environment": "Development",
        "BaseUrl": "https://localhost:5100",
        "Database": {
            "Provider": "SqlServer",
            //"ConnectionString": "Server=localhost,1433;Database=Commerce;User Id=sa;Password=Your_password123;",
            "ConnectionString": "Data Source=192.168.13.122; Initial Catalog=Commerce;User Id=sa;Password=123456; MultipleActiveResultSets=True; TrustServerCertificate=True;"

        },
        "Cache": {
            "Enabled": true,
            "Provider": "Memory",
            "KeyPrefix": "commerce",
            "RedisConnectionString": "",
            "Products": { "TtlMinutes": 15 },
            "Search": { "TtlMinutes": 2 },
            "Settings": { "TtlMinutes": 60 },
            "Output": { "TtlMinutes": 2 }
        },
        "DisasterRecovery": {
            "BackupRoot": "App_Data/backups",
            "RetentionDays": 30,
            "MinBackupsToKeep": 7,
            "MaxBackupAgeHoursBeforeAlert": 26,
            "MaxRestoreTestAgeDaysBeforeAlert": 30,
            "EnableScheduledBackups": true,
            "MediaRoot": "App_Data/media",
            "PluginsRoot": "Plugins",
            "MaskSecretsInConfigurationBackup": true
        }
    }
}
